# Galaxy Mind · environment variable names (no values).
# Copy to .env.local for local development and fill in only what you need.
# Every variable is optional for `npm run dev`: features without their keys
# turn themselves off (KV runs in no-op mode, email is "not configured",
# X login is off, and direct rentals stay closed).
# Never commit actual values. Server-only secrets must never get a NEXT_PUBLIC_ prefix.

# --- Site and auth ---
CRON_SECRET=
ADMIN_SECRET=
ARCADE_SESSION_SECRET=
UNSUB_SECRET=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
BING_SITE_VERIFICATION=
YANDEX_VERIFICATION=
INDEXNOW_KEY=
SUPPORT_DISCORD_URL=

# --- Storage (Upstash / Vercel KV) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
RESEND_FROM_EMAIL=
SUBMISSION_NOTIFY_EMAIL=
SOCIAL_DRAFTS_EMAIL=

# --- Web push ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- X and Nostr ---
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
NOSTR_NSEC_HEX=
NOSTR_DELEGATION_TAG=
NOSTR_RELAYS=
SOCIAL_AUTOMATION_DISABLED=
DRY_RUN_SOCIAL=

# --- Search Console script (scripts/pull-gsc.ts) ---
GSC_SITE_URL=
GSC_SERVICE_ACCOUNT_JSON=
GSC_SERVICE_ACCOUNT_FILE=

# --- Hashrate rentals ---
# RENTALS_MODE defaults to mrr_only: every direct checkout route answers 410
# and renters are sent to the marketplace. Only the exact value "direct"
# reopens direct checkout.
RENTALS_MODE=
MRR_MIN_BTC_PH_DAY=
RENTAL_STATUS_FEED_ORIGIN=
RENTALS_PUBLIC_BASE_URL=
RENTALS_KILL=
RENTALS_PILOT=
PILOT_RIG_ALLOWLIST=
RENTALS_SUPABASE_URL=
RENTALS_SUPABASE_KEY=
RENTALS_SUPABASE_SERVICE_KEY=
RENTALS_PRICING_READ_KEY=
# Phase 2 (direct checkout backend; off unless RENTALS_MODE=direct)
RENTALS_PHASE2_ENABLED=
RENTALS_PHASE2_MODE=
RENTALS_PHASE2_SUPABASE_URL=
RENTALS_PHASE2_SUPABASE_SERVICE_KEY=
RENTALS_PHASE2_STAGING_BTCUSD=
RENTALS_PHASE2_STAGING_PRICING=
RENTALS_CODE_HMAC_KEY=
RENTALS_JOB_SIGNING_KEY_PEM=
RENTALS_JOB_SIGNING_KID=
RENTALS_DB_COMMIT_CAP=
RENTALS_AVAIL_GATE=
RENTALS_ALERTS_OUTBOX=
RENTALS_OUTBOX_FORWARDER_READY=
RENTALS_NTFY_URL=
RENTALS_NTFY_TOPIC=
RENTALS_NTFY_TOKEN=
RENTALS_HUMAN_CHECKOUT=
RENTALS_MAINNET_ENABLED=
RENTALS_MAINNET_ACK=
RENTALS_TEST_ORDER_ROUTE_ENABLED=
RENTALS_TEST_ORDER_TOKEN=
RENTALS_X402_NETWORK=
RENTALS_X402_FACILITATOR=
RENTALS_X402_PAYTO_TEST=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
RENTALS_BASE_MAINNET_RPC=
RENTALS_SOLANA_ENABLED=
RENTALS_SOLANA_RPC=
RENTALS_SOLANA_FEE_PAYER=
RENTALS_LIGHTNING_ENABLED=
RENTALS_BTC_ONCHAIN_ENABLED=
BTC_ONCHAIN_DESCRIPTOR=
RENTALS_ETH_USDC_ENABLED=
RENTALS_ETH_RPC=
RENTALS_ETH_PAYTO=
RENTALS_ETH_NODE_READY=
# Listing ids and receive addresses (server-only; read from env, not from the code).
# GALAXY_MIND_RIG_IDS / GALAXY_MIND_XP_UNIT_IDS: comma-separated marketplace listing ids
# shown on /hashrate (an empty or malformed value shows no machines).
# RENTALS_PAYTO_PIN_EVM / RENTALS_PAYTO_PIN_SOLANA: the receive addresses. Each must hash
# (sha256) to the pin in src/lib/rentals/phase2/payto-pins.ts, and EVM must be exact EIP-55,
# or the rail refuses to quote.
GALAXY_MIND_RIG_IDS=
GALAXY_MIND_XP_UNIT_IDS=
RENTALS_PAYTO_PIN_EVM=
RENTALS_PAYTO_PIN_SOLANA=

# --- Never-reveal guard (CI and server-side output screen) ---
NEVER_REVEAL_KEY=
NEVER_REVEAL_DIGESTS=
